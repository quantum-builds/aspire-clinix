generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ReferralForm {
  id                          String           @id @default(cuid())
  createdAt                   DateTime         @default(now())
  treatmentDetails            String?
  other                       String?
  referralEmail               String
  referralGDC                 String
  referralName                String
  medicalHistoryPdfUrl        String[]
  patientAddress              String
  patientDateOfBirth          DateTime
  patientEmail                String
  patientId                   String?
  patientName                 String
  patientPhoneNumber          String
  referralDentistId           String?
  attendTreatment             String
  referralPracticeNameAddress String
  cbct                        String?
  dentalSpecialty             String?
  practiceEmail               String?
  practiceName                String?
  practicePhoneNumber         String?
  cbctReportPdfUrl            String?
  prescriptionDetails         String?
  callStatus                  CallStatus?
  callDate                    DateTime?
  patient                     Patient?         @relation(fields: [patientId], references: [id])
  referralDentist             Dentist?         @relation(fields: [referralDentistId], references: [id])
  referralRequest             ReferralRequest?

  @@index([patientEmail])
}

model ReferralRequest {
  id                       String                 @id @default(cuid())
  referralFormId           String                 @unique
  assignedDentistId        String?
  appointmentId            String?                @unique
  requestStatus            ReferralRequestStatus
  dentistResponseStatus    DentistResponseStatus?
  dentistComments          String?
  proposedTreatmentDetails String?
  proposedConsultationTime String?
  respondedAt              DateTime?
  createdAt                DateTime               @default(now())
  referralForm             ReferralForm           @relation(fields: [referralFormId], references: [id])
}

model Plan {
  id                 String                @id @default(uuid())
  name               String
  description        String
  price              Float
  validity           Int
  includedTreatments String[]
  discountId         String?
  status             PlanStatus            @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  discounts          Discount?             @relation(fields: [discountId], references: [id])
  users              UserSubscribedPlans[]
}

model Discount {
  id        String       @id @default(uuid())
  type      DiscountType
  value     Float
  expiresAt DateTime
  plans     Plan[]
}

model UserSubscribedPlans {
  userId       String
  planId       String
  subscribedAt DateTime
  plans        Plan     @relation(fields: [planId], references: [id])

  @@unique([userId, planId])
}

model Dentist {
  id                  String              @id @default(cuid())
  email               String              @unique
  gdcNo               String              @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  otp                 String?
  otpInvalidationTime DateTime?
  firstName           String
  lastName            String
  appointmentIds      String[]
  role                DentistRole         @default(REFERRING_DENTIST)
  dentallyId          Int?
  fileUrl             String?
  practices           DentistOnPractice[]
  referralForms       ReferralForm[]
  reports             Report[]
}

model Patient {
  id                  String              @id @default(cuid())
  uuid                String              @unique
  mobileNumber        String
  dateOfBirth         String
  otp                 String?
  otpInvalidationTime DateTime?
  email               String
  familyId            String?
  appointmentIds      String[]
  name                String              @unique
  dentallyId          Int                 @unique
  imageUrl            String?
  referralForms       ReferralForm[]
  reports             Report[]
  subscription        Subscription?
  patientMemberships  PatientMembership[]

  @@index([familyId])
}

model Admin {
  id          String   @id @default(cuid())
  fullName    String
  email       String   @unique
  phoneNumber String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  password    String
  fileUrl     String?
}

model pendingAdmin {
  id                  String    @id @default(cuid())
  fullName            String
  email               String    @unique
  phoneNumber         String    @unique
  otp                 String?
  otpInvalidationTime DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  password            String
}

model Practice {
  id           String              @id @default(cuid())
  email        String              @unique
  name         String              @unique
  phoneNumber  String              @unique
  postcode     String
  timeZone     String
  town         String
  nhs          Boolean             @default(false)
  openingHours Json
  addressLine1 String
  addressLine2 String
  logoUrl      String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  dentists     DentistOnPractice[]
}

model DentistOnPractice {
  practiceId String
  dentistId  String
  status     PracticeApprovalStatus @default(PENDING)
  dentist    Dentist                @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  practice   Practice               @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@id([practiceId, dentistId])
}

model AppointmentRequests {
  id            String                   @id @default(cuid())
  requestedDate DateTime
  reason        String
  note          String?
  fileUrl       String?
  updatedAt     DateTime                 @updatedAt
  patientId     String
  createdAt     DateTime                 @default(now())
  status        AppointmentRequestStatus @default(PENDING)
  appointmentId String?                  @unique
}

model Report {
  id                String           @id @default(cuid())
  dentistId         String
  title             String
  fileUrl           String
  fileType          ResoucrceType
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  appointmentId     String
  patientDentallyId String
  patientId         String?
  recipientType     ReportRecipient?
  dentist           Dentist          @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  patient           Patient?         @relation(fields: [patientId], references: [id])

  @@index([appointmentId])
  @@index([patientDentallyId])
  @@index([fileType])
}

model Resource {
  id        String        @id @default(cuid())
  title     String
  fileUrl   String
  fileType  ResoucrceType
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([fileType])
}

model Product {
  id                String             @id @default(cuid())
  name              String             @unique
  price             Float
  stock             Int
  ratings           Float
  imageUrl          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  productId         String             @unique
  cartProducts      CartProduct[]
  purchasedProducts PurchasedProduct[]
}

model Cart {
  id           String        @id @default(cuid())
  patientId    String        @unique
  cartProducts CartProduct[]
}

model CartProduct {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  Cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model PurchasedProduct {
  id               String         @id @default(cuid())
  patientId        String
  productId        String
  productPaymentId String
  purchaseDate     DateTime       @default(now())
  quantity         Int
  itemId           String
  product          Product        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  payment          ProductPayment @relation(fields: [productPaymentId], references: [id])

  @@unique([productPaymentId, productId])
  @@index([patientId, productId])
}

model ProductPayment {
  id            String             @id @default(cuid())
  patientId     String
  email         String
  paymentIntent String
  amount        Float
  status        PaymentStatus      @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  products      PurchasedProduct[]

  @@unique([email, paymentIntent])
}

model Video {
  id          String @id @default(cuid())
  dentistId   String
  patientId   String
  fileContent String
  fileName    String
  fileType    String
}

model TreatmentStripe {
  treatmentId     Int      @id
  stripePriceId   String   @unique
  stripeProductId String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Subscription {
  id        String     @id @default(cuid())
  patientId String
  planId    String
  startDate DateTime
  endDate   DateTime
  status    PlanStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  patient   Patient    @relation(fields: [patientId], references: [id])

  @@unique([patientId])
}

model MembershipPlan {
  id              String   @id @default(uuid())
  name            String   @unique
  stripeProductId String   @unique
  stripePriceId   String   @unique
  treatmentLimit  Int?
  hyperbaricLimit Int?
  breathworkLimit Int      @default(0)
  guestPassLimit  Int      @default(0)
  vipEventAccess  Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships         PatientMembership[] @relation("CurrentPlan")
  pendingMemberships  PatientMembership[] @relation("PendingPlan")
}

model PatientMembership {
  id                   String           @id @default(uuid())
  patientId            String           @unique
  planId               String
  patient              Patient          @relation(fields: [patientId], references: [id]) // use your patient model name
  plan                 MembershipPlan   @relation("CurrentPlan", fields: [planId], references: [id])
  stripeCustomerId     String
  stripeSubscriptionId String           @unique
  status               MembershipStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean          @default(false)
  cancelledAt          DateTime?
  usedTreatments       Int              @default(0)
  usedHyperbaric       Int              @default(0)
  usedBreathwork       Int              @default(0)
  usedGuestPasses      Int              @default(0)
  pendingPlanId        String?
  pendingPlan          MembershipPlan?  @relation("PendingPlan", fields: [pendingPlanId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments MembershipAppointment[]

  @@index([patientId, status])
  @@index([planId])
}

model MembershipAppointment {

  id String @id @default(uuid())
  membershipId  String
  appointmentId String            @unique 
  membership    PatientMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([membershipId])
}

enum InvoiceStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum PlanStatus {
  ACTIVE
  EXPIRED
  UPCOMING
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PatientTreatmentStatus {
  SCHEDULED
  PENDING
  RESCHEDULED
  ONGOING
  COMPLETED
  CANCELED
  NO_SHOW
  FAILED
  EXPIRED
}

enum ResoucrceType {
  VIDEO
  PDF
  IMAGES
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  REFUND_PENDING
  REFUND_FAILED
}

enum DentistRole {
  DENTIST
  RECIEVING_DENTIST
  REFERRING_DENTIST
  DENTALLY_PRACTITIONER
}

enum GenderType {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ARRIVED
  IN_SURGERY
  COMPLETED
  CANCELLED
  DID_NOT_ATTEND
}

enum AppointmentRequestStatus {
  APPROVED
  PENDING
  CANCEL
}

enum UserRoles {
  ADMIN
  PATIENT
  DENTIST
}

enum PracticeApprovalStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum ReferralRequestStatus {
  UNASSIGNED
  PENDING_REVIEW
  ACCEPTED
  REJECTED_BY_DENTIST
  ASSIGNED
  REJECTED_BY_PATIENT
}

enum DentistResponseStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReportRecipient {
  PATIENT
  REFERRING_DENTIST
}

enum CallStatus {
  PENDING
  AWAITING
  REJECTED
  UNATTENDED
  CONFIRM
}

enum MembershipStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}
